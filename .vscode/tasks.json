{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${filebasenameNoExtension}.exe",
                "-lgraphics64",
                "-lgdi32",
                "-limm32",
                "-lmsimg32",
                "-lole32",
                "-loleaut32",
                "-luuid",
                "-lwinmm",
                "-lgdiplus"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译器: C:/msys64/ucrt64/bin/g++.exe"
        },
        {
            "label": "生成DOxygen文档",
            "type": "shell",
            "command": "doxygen Doxyfile",
            "problemMatcher":[]

        }
    ]
}